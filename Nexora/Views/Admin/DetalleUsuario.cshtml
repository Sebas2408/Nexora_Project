@model Nexora.ViewModels.UsuarioDetalleAdminViewModel
@{ ViewData["Title"] = "Detalle de usuario"; }
<div class="py-3" style="max-width: 700px"><a asp-controller="Usuarios" asp-action="Index" class="btn btn-link px-0">← Usuarios</a><div class="d-flex justify-content-between align-items-center"><h1 class="h3">Detalle de usuario</h1><a asp-controller="Usuarios" asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a></div>
<dl class="row mt-4"><dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.Nombre @Model.Apellido</dd><dt class="col-sm-4">Correo</dt><dd class="col-sm-8">@Model.Email</dd><dt class="col-sm-4">Dirección</dt><dd class="col-sm-8">@(Model.Direccion ?? "—")</dd><dt class="col-sm-4">Rol</dt><dd class="col-sm-8">@Model.Rol</dd><dt class="col-sm-4">Estado</dt><dd class="col-sm-8">@(Model.Bloqueado ? "Bloqueado" : "Activo")</dd>@if (Model.Tienda != null) { <dt class="col-sm-4">Tienda</dt><dd class="col-sm-8">@Model.Tienda</dd> }</dl></div>
