@model Nexora.ViewModels.AdminVendedoresViewModel
@{
    ViewData["Title"] = "Panel Admin - Vendedores";
    string query = Model.Query ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="admin-page">
    <div class="admin-header">
        <div>
            <h1 class="admin-title">Panel de administración</h1>
            <p class="admin-subtitle">Gestión y visualización de vendedores registrados</p>
        </div>
        <a class="btn btn-dark" asp-action="RegistrarVendedor">+ Registrar nuevo comerciante</a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success admin-alert" role="alert">@TempData["Mensaje"]</div>
    }

    <div class="admin-stats">
        <div class="admin-stat-card">
            <span class="admin-stat-value">@Model.TotalVendedores</span>
            <span class="admin-stat-label">Total de vendedores</span>
        </div>
        <div class="admin-stat-card admin-stat-active">
            <span class="admin-stat-value">@Model.TotalActivos</span>
            <span class="admin-stat-label">Activos</span>
        </div>
        <div class="admin-stat-card admin-stat-inactive">
            <span class="admin-stat-value">@Model.TotalSuspendidos</span>
            <span class="admin-stat-label">Inactivos</span>
        </div>
    </div>

    <div class="admin-toolbar card shadow-sm">
        <div class="card-body">
            <form method="get" class="admin-search-form">
                <div class="input-group">
                    <span class="input-group-text admin-search-icon">⌕</span>
                    <input type="text" name="q" value="@query" class="form-control" placeholder="Buscar empresa, contacto, correo o dominio..." />
                    <select name="activo" class="form-select" aria-label="Filtrar por estado">
                        <option value="">Todos los estados</option>
                        <option value="true" selected="@(Model.Activo == true)">Activo</option>
                        <option value="false" selected="@(Model.Activo == false)">Suspendido</option>
                    </select>
                    <select name="orden" class="form-select" aria-label="Ordenar por">
                        <option value="tienda" selected="@(Model.Orden == "tienda")">Empresa</option>
                        <option value="fecha" selected="@(Model.Orden == "fecha")">Fecha de registro</option>
                        <option value="productos" selected="@(Model.Orden == "productos")">Productos</option>
                        <option value="estado" selected="@(Model.Orden == "estado")">Estado</option>
                    </select>
                    <input type="hidden" name="ascendente" value="@Model.Ascendente.ToString().ToLowerInvariant()" />
                    <button type="submit" class="btn btn-primary">Buscar</button>
                    @if (!string.IsNullOrWhiteSpace(query))
                    {
                        <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Vendedores">Limpiar</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="admin-table-card card shadow-sm">
        @if (!Model.Vendedores.Any())
        {
            <div class="admin-empty">
                <p class="admin-empty-title">No se encontraron vendedores.</p>
                <p class="admin-empty-text">Intenta con otro término de búsqueda.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table admin-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Vendedor / dominio</th>
                            <th>Fecha de registro</th>
                            <th class="text-center">Productos</th>
                            <th class="text-end">Ingresos históricos</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.Vendedores)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@v.NombreTienda</div>
                                    <small class="text-muted">@v.NombreCompleto · @v.Email</small>
                                </td>
                                <td>@(v.FechaRegistro?.ToLocalTime().ToString("dd MMM yyyy") ?? "No disponible")</td>
                                <td class="text-center">@v.CantidadProductos</td>
                                <td class="text-end">@v.IngresosHistoricos.ToString("C")</td>
                                <td class="text-center">
                                    @if (v.Activo)
                                    {
                                        <span class="admin-badge admin-badge-active">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge admin-badge-inactive">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="admin-actions">
                                        <a class="btn btn-sm btn-outline-primary" asp-action="DetalleVendedor" asp-route-id="@v.Id">Ver detalle</a>
                                        <a class="btn btn-sm btn-outline-secondary" asp-action="EditarVendedor" asp-route-id="@v.Id">Editar</a>
                                        <form asp-action="CambiarEstadoVendedor" asp-route-id="@v.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="activo" value="@(!v.Activo).ToString().ToLowerInvariant()" />
                                            <input type="hidden" name="returnUrl" value="@Url.Action("Vendedores", "Admin", new { q = query, activo = Model.Activo, orden = Model.Orden, ascendente = Model.Ascendente, pagina = Model.Pagina })" />
                                            @if (v.Activo)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Confirmas la suspensión de este vendedor?');">Suspender</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success" onclick="return confirm('¿Confirmas la reactivación de este vendedor?');">Reactivar</button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    @if (Model.TotalPaginas > 1)
    {
        <nav aria-label="Paginación de vendedores" class="mt-3">
            <ul class="pagination justify-content-end">
                <li class="page-item @(Model.Pagina <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Vendedores" asp-route-q="@Model.Query" asp-route-activo="@Model.Activo" asp-route-orden="@Model.Orden" asp-route-ascendente="@Model.Ascendente" asp-route-pagina="@(Model.Pagina - 1)">Anterior</a>
                </li>
                <li class="page-item disabled"><span class="page-link">Página @Model.Pagina de @Model.TotalPaginas (@Model.TotalResultados)</span></li>
                <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Vendedores" asp-route-q="@Model.Query" asp-route-activo="@Model.Activo" asp-route-orden="@Model.Orden" asp-route-ascendente="@Model.Ascendente" asp-route-pagina="@(Model.Pagina + 1)">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>
