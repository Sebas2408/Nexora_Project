@model Nexora.ViewModels.VendedorDetalleViewModel
@{
    ViewData["Title"] = "Detalle del vendedor - " + Model.NombreTienda;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="admin-page">
    <a class="admin-back-link" asp-action="Vendedores">← Volver a vendedores</a>

    <div class="admin-detail-card card shadow-sm">
        <div class="card-body">
            <div class="admin-detail-header">
                <img src="@(Model.Logo ?? "/images/placeholder.png")" alt="@Model.NombreTienda" class="admin-detail-logo" />
                <div>
                    <h1 class="admin-detail-title">@Model.NombreTienda</h1>
                    @if (Model.Activo)
                    {
                        <span class="admin-badge admin-badge-active">Activo</span>
                    }
                    else
                    {
                        <span class="admin-badge admin-badge-inactive">Inactivo</span>
                    }
                </div>

                <a class="btn btn-outline-primary" asp-action="EditarVendedor" asp-route-id="@Model.Id">Editar ficha</a>

                <form asp-action="CambiarEstadoVendedor" asp-route-id="@Model.Id" method="post" class="admin-detail-toggle">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="activo" value="@(!Model.Activo).ToString().ToLowerInvariant()" />
                    <input type="hidden" name="returnUrl" value="@Url.Action("DetalleVendedor", "Admin", new { id = Model.Id })" />
                    @if (Model.Activo)
                    {
                        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('¿Confirmas la suspensión de este vendedor?');">Suspender vendedor</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-outline-success" onclick="return confirm('¿Confirmas la reactivación de este vendedor?');">Reactivar vendedor</button>
                    }
                </form>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
            {
                <p class="admin-detail-desc">@Model.Descripcion</p>
            }

            <div class="admin-detail-info">
                <div>
                    <span class="admin-detail-label">Propietario</span>
                    <span class="admin-detail-value">@Model.NombreCompleto</span>
                </div>
                <div>
                    <span class="admin-detail-label">Correo</span>
                    <span class="admin-detail-value">@Model.Email</span>
                </div>
                <div>
                    <span class="admin-detail-label">Dirección</span>
                    <span class="admin-detail-value">@(Model.Direccion ?? "No registrada")</span>
                </div>
                <div>
                    <span class="admin-detail-label">Fecha de registro</span>
                    <span class="admin-detail-value">@(Model.FechaRegistro?.ToLocalTime().ToString("dd MMMM yyyy") ?? "No disponible")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="admin-stats mt-3">
        <div class="admin-stat-card"><span class="admin-stat-value">@Model.Productos.Count</span><span class="admin-stat-label">Productos</span></div>
        <div class="admin-stat-card admin-stat-active"><span class="admin-stat-value">@Model.ProductosActivos</span><span class="admin-stat-label">Productos activos</span></div>
        <div class="admin-stat-card admin-stat-inactive"><span class="admin-stat-value">@Model.ProductosInactivos</span><span class="admin-stat-label">Productos inactivos</span></div>
        <div class="admin-stat-card"><span class="admin-stat-value">@Model.PedidosAsociados</span><span class="admin-stat-label">Pedidos asociados</span></div>
        <div class="admin-stat-card"><span class="admin-stat-value">@Model.UnidadesVendidas</span><span class="admin-stat-label">Unidades vendidas</span></div>
        <div class="admin-stat-card"><span class="admin-stat-value">@Model.IngresosHistoricos.ToString("C")</span><span class="admin-stat-label">Ingresos no cancelados</span></div>
        <div class="admin-stat-card"><span class="admin-stat-value">@(Model.ActividadReciente?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</span><span class="admin-stat-label">Actividad reciente</span></div>
    </div>

    <h2 class="admin-section-title">Catálogo del vendedor (@Model.Productos.Count)</h2>

    @if (!Model.Productos.Any())
    {
        <div class="admin-table-card card shadow-sm">
            <div class="admin-empty">
                <p class="admin-empty-title">Este vendedor aún no ha publicado productos.</p>
            </div>
        </div>
    }
    else
    {
        <div class="admin-table-card card shadow-sm">
            <div class="table-responsive">
                <table class="table admin-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Marca</th>
                            <th>SKU</th>
                            <th>Categoría</th>
                            <th class="text-end">Precio</th>
                            <th class="text-center">Stock</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Productos)
                        {
                            <tr>
                                <td class="fw-semibold">@p.Nombre</td>
                                <td>@p.Marca</td>
                                <td>@p.SKU</td>
                                <td>@(p.Categoria?.Nombre ?? "—")</td>
                                <td class="text-end">@p.Precio.ToString("C")</td>
                                <td class="text-center">@p.Stock</td>
                                <td class="text-center">
                                    @if (p.Activo)
                                    {
                                        <span class="admin-badge admin-badge-active">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge admin-badge-inactive">Inactivo</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
