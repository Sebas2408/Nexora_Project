@model Nexora.ViewModels.AdminInventarioViewModel
@{
    ViewData["Title"] = "Gestor administrativo de inventario";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="admin-page">
    <div class="admin-header">
        <div>
            <h1 class="admin-title">Gestor administrativo de inventario</h1>
            <p class="admin-subtitle">Consulta de productos y existencias. Esta vista no modifica el inventario.</p>
        </div>
    </div>

    <div class="admin-toolbar card shadow-sm">
        <div class="card-body">
            <form method="get" asp-action="Inventario" class="row g-2 align-items-end">
                <div class="col-lg-3 col-md-6">
                    <label class="form-label" for="q">Buscar</label>
                    <input id="q" name="q" value="@Model.Query" class="form-control" placeholder="Nombre, marca, modelo o SKU" />
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label" for="vendedorId">Vendedor</label>
                    <select id="vendedorId" name="vendedorId" class="form-select">
                        <option value="">Todos</option>
                        @foreach (var vendedor in Model.Vendedores)
                        {
                            <option value="@vendedor.Id" selected="@(Model.VendedorId == vendedor.Id)">@vendedor.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label" for="categoriaId">Categoría</label>
                    <select id="categoriaId" name="categoriaId" class="form-select">
                        <option value="">Todas</option>
                        @foreach (var categoria in Model.Categorias)
                        {
                            <option value="@categoria.Id" selected="@(Model.CategoriaId == categoria.Id)">@categoria.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label" for="estado">Estado</label>
                    <select id="estado" name="estado" class="form-select">
                        <option value="todos" selected="@(Model.Estado == "todos")">Todos</option>
                        <option value="activo" selected="@(Model.Estado == "activo")">Activo</option>
                        <option value="inactivo" selected="@(Model.Estado == "inactivo")">Inactivo</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label" for="existencias">Existencias</label>
                    <select id="existencias" name="existencias" class="form-select">
                        <option value="todas" selected="@(Model.Existencias == "todas")">Todas</option>
                        <option value="bajo" selected="@(Model.Existencias == "bajo")">Bajas</option>
                        <option value="cero" selected="@(Model.Existencias == "cero")">Sin existencias</option>
                        <option value="normal" selected="@(Model.Existencias == "normal")">Normales</option>
                    </select>
                </div>
                <div class="col-lg-1 col-md-6">
                    <label class="form-label" for="umbralStockBajo">Umbral</label>
                    <input id="umbralStockBajo" name="umbralStockBajo" type="number" min="1" max="10000" value="@Model.UmbralStockBajo" class="form-control" />
                </div>
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Aplicar filtros</button>
                    <a asp-action="Inventario" class="btn btn-outline-secondary">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="admin-table-card card shadow-sm">
        @if (Model.Productos.Count == 0)
        {
            <div class="admin-empty">
                <p class="admin-empty-title">No hay productos que coincidan con los filtros.</p>
                <p class="admin-empty-text">Modifica los criterios de búsqueda e inténtalo de nuevo.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table admin-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Producto / SKU</th>
                            <th>Categoría</th>
                            <th>Vendedor</th>
                            <th class="text-center">Cantidad</th>
                            <th>Estado</th>
                            <th class="text-end">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var producto in Model.Productos)
                        {
                            <tr>
                                <td><div class="fw-semibold">@producto.Nombre</div><small class="text-muted">@producto.SKU</small></td>
                                <td>@producto.Categoria</td>
                                <td>@producto.Vendedor</td>
                                <td class="text-center">
                                    @if (producto.Stock == 0)
                                    {
                                        <span class="admin-badge admin-badge-inactive">0</span>
                                    }
                                    else if (producto.Stock <= Model.UmbralStockBajo)
                                    {
                                        <span class="admin-badge admin-badge-inactive">@producto.Stock · Bajo</span>
                                    }
                                    else
                                    {
                                        @producto.Stock
                                    }
                                </td>
                                <td>
                                    <span class="admin-badge @(producto.Activo ? "admin-badge-active" : "admin-badge-inactive")">@(producto.Activo ? "Activo" : "Inactivo")</span>
                                </td>
                                <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="DetalleProducto" asp-route-id="@producto.Id">Detalle</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (Model.TotalPaginas > 1)
    {
        <nav aria-label="Paginación del inventario" class="mt-3">
            <ul class="pagination justify-content-end">
                <li class="page-item @(Model.Pagina <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Inventario" asp-route-q="@Model.Query" asp-route-vendedorId="@Model.VendedorId" asp-route-categoriaId="@Model.CategoriaId" asp-route-estado="@Model.Estado" asp-route-existencias="@Model.Existencias" asp-route-umbralStockBajo="@Model.UmbralStockBajo" asp-route-pagina="@(Model.Pagina - 1)">Anterior</a>
                </li>
                <li class="page-item disabled"><span class="page-link">Página @Model.Pagina de @Model.TotalPaginas (@Model.TotalResultados)</span></li>
                <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Inventario" asp-route-q="@Model.Query" asp-route-vendedorId="@Model.VendedorId" asp-route-categoriaId="@Model.CategoriaId" asp-route-estado="@Model.Estado" asp-route-existencias="@Model.Existencias" asp-route-umbralStockBajo="@Model.UmbralStockBajo" asp-route-pagina="@(Model.Pagina + 1)">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>
