<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nexora</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/Nexora.styles.css" asp-append-version="true" />
</head>
<body class="admin-layout">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark custom-header shadow-sm mb-3">
            <div class="container-fluid header-inner">
                <a class="navbar-brand" asp-controller="Admin" asp-action="Vendedores">Nexora · Administración</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex align-items-center justify-content-between w-100 header-collapse">
                    <ul class="navbar-nav header-nav header-nav-left">
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link" asp-controller="Admin" asp-action="Inventario">Gestor de inventario</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link" asp-controller="Admin" asp-action="Vendedores">Vendedores registrados</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link" asp-controller="Admin" asp-action="Analiticas">Analíticas del sistema</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios y roles</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto header-nav header-nav-right">
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link" asp-controller="Admin" asp-action="PerfilAdministrador">@User.Identity?.Name</a>
                        </li>
                        <li class="nav-item">
                            <form class="d-inline" asp-controller="Admin" asp-action="CerrarSesion" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link nav-link custom-nav-link logout-button">Cerrar sesión</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container flex-grow-1">
        <main role="main" class="main-container">
            @RenderBody()
        </main>
    </div>

    <footer class="footer custom-footer mt-auto">
        <div class="container footer-content">
            <span class="footer-brand">Nex<span class="footer-brand-accent">ora</span></span>
            <span class="footer-divider" aria-hidden="true"></span>
            <span class="footer-rights">Derechos Reservados &copy; 2026.</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
