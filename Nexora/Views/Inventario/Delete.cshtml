@model Nexora.Models.Producto

@{
    ViewData["Title"] = "Eliminar producto";
}

@section Styles {
    <link rel="stylesheet" href="~/css/inventario.css" asp-append-version="true" />
}

<div class="inventory-page">
    <div class="container-fluid inventory-container">
        <section class="inventory-card inventory-delete-card" aria-labelledby="delete-title">
            <header class="inventory-header inventory-delete-header">
                <div>
                    <p class="inventory-delete-eyebrow">Confirmación de eliminación</p>
                    <h1 class="inventory-title" id="delete-title">¿Eliminar este producto?</h1>
                    <p class="inventory-subtitle">Revisa los datos antes de continuar. Esta acción no se puede deshacer.</p>
                </div>
                <span class="inventory-delete-icon" aria-hidden="true">
                    <i class="bi bi-exclamation-triangle"></i>
                </span>
            </header>

            <div class="inventory-delete-warning" role="alert">
                <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                <p>El producto se eliminará definitivamente del inventario.</p>
            </div>

            <section class="inventory-delete-product" aria-label="Datos del producto que se eliminará">
                <div class="inventory-delete-product-heading">
                    <span class="inventory-delete-product-icon" aria-hidden="true">
                        <i class="bi bi-box-seam"></i>
                    </span>
                    <div>
                        <p class="inventory-delete-label">Producto seleccionado</p>
                        <h2>@Model.Nombre</h2>
                    </div>
                </div>

                <dl class="inventory-delete-details">
                    <div><dt>Marca</dt><dd>@Model.Marca</dd></div>
                    <div><dt>Modelo</dt><dd>@(Model.Modelo ?? "—")</dd></div>
                    <div><dt>Referencia (SKU)</dt><dd class="inventory-mono">@Model.SKU</dd></div>
                    <div><dt>Categoría</dt><dd>@(Model.Categoria?.Nombre ?? "—")</dd></div>
                    <div><dt>Precio</dt><dd class="inventory-price">@Model.Precio.ToString("C")</dd></div>
                    <div><dt>Stock</dt><dd>@Model.Stock unidades</dd></div>
                </dl>
            </section>

            <div class="inventory-form-actions inventory-delete-actions">
                <a asp-action="Index" class="btn btn-outline-secondary inventory-secondary-btn">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i> Cancelar y volver
                </a>
                <form asp-action="Delete" method="post" class="inventory-delete-form">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn inventory-delete-confirm-btn">
                        <i class="bi bi-trash3" aria-hidden="true"></i> Eliminar producto
                    </button>
                </form>
            </div>
        </section>
    </div>
</div>
