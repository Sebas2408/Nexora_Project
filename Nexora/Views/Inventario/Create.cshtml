@model Nexora.Models.Producto

@{
    ViewData["Title"] = "Añadir producto";
}

@section Styles {
    <link rel="stylesheet" href="~/css/inventario.css" asp-append-version="true" />
}

<div class="inventory-page">
    <div class="container-fluid inventory-container">
        <div class="inventory-card shadow-sm">
            <div class="inventory-header">
                <div>
                    <h1 class="inventory-title"><i class="bi bi-box-seam inventory-heading-icon" aria-hidden="true"></i> Añadir producto</h1>
                    <p class="inventory-subtitle">Completa la información para incorporar un producto al inventario.</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary inventory-secondary-btn">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i> Volver al inventario
                </a>
            </div>

            <form asp-action="Create" method="post" enctype="multipart/form-data" class="inventory-form">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <section class="inventory-form-section" aria-labelledby="product-info-heading">
                    <div class="inventory-section-heading">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        <div>
                            <h2 id="product-info-heading">Información del producto</h2>
                            <p>Identificación y características principales.</p>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej.: Smartphone Pro" maxlength="200" autocomplete="off" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SKU" class="form-label"></label>
                            <input asp-for="SKU" class="form-control" placeholder="Código único del producto" maxlength="100" autocomplete="off" />
                            <span asp-validation-for="SKU" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Marca" class="form-label"></label>
                            <input asp-for="Marca" class="form-control" maxlength="100" autocomplete="off" />
                            <span asp-validation-for="Marca" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Modelo" class="form-label"></label>
                            <input asp-for="Modelo" class="form-control" maxlength="100" autocomplete="off" />
                            <span asp-validation-for="Modelo" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Especificaciones" class="form-label"></label>
                            <textarea asp-for="Especificaciones" class="form-control" rows="3" maxlength="2000"></textarea>
                            <span asp-validation-for="Especificaciones" class="text-danger"></span>
                        </div>
                        <partial name="_ProductoImagenInput" model="Model" />
                    </div>
                </section>

                <section class="inventory-form-section" aria-labelledby="stock-info-heading">
                    <div class="inventory-section-heading">
                        <i class="bi bi-archive" aria-hidden="true"></i>
                        <div>
                            <h2 id="stock-info-heading">Precio y disponibilidad</h2>
                            <p>Define el precio, las unidades disponibles y las asignaciones.</p>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Precio" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Precio" class="form-control" type="number" min="0.01" max="9999999" step="0.01" inputmode="decimal" />
                            </div>
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Stock" class="form-label"></label>
                            <input asp-for="Stock" class="form-control" type="number" min="0" max="1000000" step="1" inputmode="numeric" />
                            <span asp-validation-for="Stock" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 inventory-warranty-field">
                            <label asp-for="GarantiaMeses" class="form-label"></label>
                            <input asp-for="GarantiaMeses" class="form-control" type="number" min="0" max="120" step="1" inputmode="numeric" />
                            <span asp-validation-for="GarantiaMeses" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoriaId" class="form-label"></label>
                            <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId">
                                <option value="">Selecciona una categoría</option>
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="VendedorId" class="form-label">Tienda responsable</label>
                            <select asp-for="VendedorId" class="form-select" asp-items="ViewBag.VendedorId">
                                <option value="">Selecciona un vendedor</option>
                            </select>
                            <span asp-validation-for="VendedorId" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch inventory-status-toggle">
                                <input asp-for="Activo" class="form-check-input" />
                                <label asp-for="Activo" class="form-check-label"></label>
                                <span class="inventory-status-hint">El producto estará visible y disponible en el catálogo.</span>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="inventory-form-actions">
                    <a asp-action="Index" class="btn btn-outline-secondary inventory-secondary-btn">Cancelar</a>
                    <button type="submit" class="btn btn-primary inventory-create-btn">
                        <i class="bi bi-check2-circle" aria-hidden="true"></i> Guardar producto
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/product-image-input.js" asp-append-version="true"></script>
}