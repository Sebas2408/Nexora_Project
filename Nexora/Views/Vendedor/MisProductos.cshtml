@model List<Nexora.Models.Producto>
@{
    ViewData["Title"] = "Mis productos - Panel Vendedor";
}

<h1>Mis productos</h1>

<p>
    <a class="btn btn-primary" href="@Url.Action("Crear", "Vendedor")">Agregar nuevo producto</a>
</p>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (!Model.Any())
{
    <p>No tienes productos registrados.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Marca</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Activo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Nombre</td>
                    <td>@p.Marca</td>
                    <td>@p.Precio.ToString("C")</td>
                    <td>@p.Stock</td>
                    <td>@(p.Activo ? "Sí" : "No")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="EditarProducto" asp-route-id="@p.Id">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="EliminarProducto" asp-route-id="@p.Id">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

