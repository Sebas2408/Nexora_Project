@model Nexora.ViewModels.PedidoDetalleViewModel
@{
    ViewData["Title"] = "Pedido #" + Model.Id;
}

<div class="py-4">
    <a asp-action="Index" class="btn btn-link px-0">← Mis pedidos</a>
    <h1 class="h3">Pedido #@Model.Id</h1>
    <p class="text-muted">@Model.FechaCreacion.ToLocalTime().ToString("f") · Estado: <strong>@Model.Estado</strong></p>
    <div class="row mb-4">
        <div class="col-md-6"><strong>Envío</strong><p>@Model.DireccionEnvio</p></div>
        <div class="col-md-6"><strong>Pago</strong><p>@Model.MetodoPago</p></div>
    </div>
    <div class="table-responsive">
        <table class="table"><thead><tr><th>Producto</th><th>Cantidad</th><th>Precio</th><th>Subtotal</th></tr></thead>
        <tbody>@foreach (var linea in Model.Lineas) { <tr><td>@linea.NombreProducto</td><td>@linea.Cantidad</td><td>@linea.PrecioUnitario.ToString("C")</td><td>@linea.Subtotal.ToString("C")</td></tr> }</tbody>
        <tfoot><tr><th colspan="3" class="text-end">Total</th><th>@Model.Total.ToString("C")</th></tr></tfoot></table>
    </div>
</div>
