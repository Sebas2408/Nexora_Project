@model List<Nexora.ViewModels.ProductoViewModel>
@{
    ViewData["Title"] = "Catálogo - Nexora";
    var categorias = ViewBag.Categorias as List<Nexora.Models.Categoria> ?? new List<Nexora.Models.Categoria>();
    int? categoriaSeleccionada = ViewBag.CategoriaSeleccionada as int?;
    string query = ViewBag.Query as string ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="catalog-page">
    <div class="catalog-shell">
        <aside class="catalog-filters card shadow-sm">
            <div class="card-body">
                <div class="catalog-filters-header">
                    <h2 class="catalog-title">Filtros</h2>
                    <a class="catalog-reset" href="@Url.Action("Index", "Home")">Restablecer todo</a>
                </div>

                <div class="catalog-filter-group">
                    <h3 class="catalog-filter-label">Categorias</h3>
                    <div class="catalog-category-list">
                        <a class="catalog-category-item @(categoriaSeleccionada == null ? "active" : "")" href="@Url.Action("Index", "Home")">
                            <span>Todo el equipamiento</span>
                            <span class="catalog-category-arrow">›</span>
                        </a>
                        @foreach (var c in categorias)
                        {
                            <a class="catalog-category-item @(categoriaSeleccionada == c.Id ? "active" : "")" href="@Url.Action("Index", "Home", new { categoriaId = c.Id })">
                                <span>@c.Nombre</span>
                                <span class="catalog-category-arrow">›</span>
                            </a>
                        }
                    </div>
                </div>

                <div class="catalog-filter-group">
                    <h3 class="catalog-filter-label">Rango de precio</h3>
                    <form method="get" action="@Url.Action("Index", "Home")" class="catalog-price-range-form">
                        <div class="catalog-price-range">
                            <input type="number" name="precioMin" step="0.01" min="0" class="form-control catalog-mini-input" placeholder="$ Min" value="@(ViewBag.PrecioMin ?? "")" />
                            <input type="number" name="precioMax" step="0.01" min="0" class="form-control catalog-mini-input" placeholder="$ Max" value="@(ViewBag.PrecioMax ?? "")" />
                        </div>
                        <input type="hidden" name="categoriaId" value="@(categoriaSeleccionada?.ToString() ?? "")" />
                        <input type="hidden" name="q" value="@query" />
                        <div class="catalog-price-actions d-flex align-items-center gap-2">
                            <button type="submit" class="btn btn-sm btn-primary" aria-label="Aplicar filtro de precio" title="Aplicar">Aplicar</button>
                            <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Index", "Home")" aria-label="Limpiar filtros" title="Limpiar">Limpiar</a>
                        </div>
                    </form>
                </div>
            </div>
        </aside>

        <section class="catalog-content">
            <div class="catalog-toolbar card shadow-sm">
                <div class="card-body catalog-toolbar-body">
                    <form method="get" class="catalog-search">
                        <div class="input-group catalog-search-group">
                            <span class="input-group-text catalog-search-icon">⌕</span>
                            <input type="text" name="q" value="@query" class="form-control catalog-search-input" placeholder="Buscar en el catálogo de tecnología..." />
                        </div>
                    </form>

                    @* Se elimina el apartado de "Ordenar por" según solicitud *@
                </div>
            </div>

            <div class="catalog-grid">
                @foreach (var p in Model)
                {
                    <article class="catalog-card card shadow-sm">
                        <div class="catalog-card-image-wrap">
                            <img src="@(p.ImagenUrl ?? "/images/placeholder.png")" class="catalog-card-image" alt="@p.Nombre" />
                        </div>

                        <div class="card-body catalog-card-body">
                            <div class="catalog-card-meta">
                                <div class="catalog-rating">
                                    <span class="catalog-stars">☆☆☆☆☆</span>
                                    <span class="catalog-rating-value">(4.8)</span>
                                </div>
                                <span class="catalog-stock">En stock</span>
                            </div>

                            <h5 class="catalog-card-title">@p.Nombre</h5>
                            <p class="catalog-card-text">@p.Marca @if (!string.IsNullOrEmpty(p.Modelo)) { <span>- @p.Modelo</span> }</p>

                            <div class="catalog-card-footer">
                                <p class="catalog-price">@p.Precio.ToString("C")</p>
                                <div class="catalog-card-actions">
                                    <a class="btn btn-sm catalog-button catalog-button-secondary" href="@Url.Action("Detalle", "Home", new { id = p.Id })">Ver detalle</a>
                                    <form asp-controller="Cart" asp-action="Agregar" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productoId" value="@p.Id" />
                                        <input type="hidden" name="cantidad" value="1" />
                                        <button type="submit" class="btn btn-sm catalog-button catalog-button-primary">Agregar al carrito</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    </div>
</div>
