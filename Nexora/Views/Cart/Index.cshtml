@model Nexora.ViewModels.CarritoResumenViewModel
@{
    ViewData["Title"] = "Carrito de compras";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <h1 class="h3">Carrito de compras</h1>
        <div class="text-muted">@Model.CantidadUnidades unidad(es) en @Model.Items.Count producto(s)</div>
    </div>

    @if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
    @if (TempData["Advertencias"] is string advertencias)
    {
        <div class="alert alert-warning"><ul class="mb-0">@foreach (var advertencia in advertencias.Split('|')) { <li>@advertencia</li> }</ul></div>
    }

    @if (!Model.Items.Any())
    {
        <div class="alert alert-secondary">El carrito está vacío.</div>
        <a class="btn btn-link" asp-controller="Home" asp-action="Index">← Continuar comprando</a>
    }
    else
    {
        <div class="row gx-4">
            <div class="col-lg-8">
                @foreach (var item in Model.Items)
                {
                    <div class="card mb-3"><div class="card-body d-flex align-items-center gap-3">
                        <img src="@(item.ImagenUrl ?? "/images/placeholder.png")" alt="@item.Nombre" style="width:96px;height:72px;object-fit:cover" class="rounded" />
                        <div class="flex-grow-1"><div class="fw-semibold">@item.Nombre</div><div class="text-muted small">@item.Precio.ToString("C") por unidad</div></div>
                        <div class="d-flex align-items-center">
                            <form asp-action="ActualizarCantidad" method="post">@Html.AntiForgeryToken()<input type="hidden" name="productoId" value="@item.ProductoId" /><input type="hidden" name="cantidad" value="@(item.Cantidad - 1)" /><button class="btn btn-outline-secondary" @(item.Cantidad == 1 ? "disabled" : null)>−</button></form>
                            <span class="px-3">@item.Cantidad</span>
                            <form asp-action="ActualizarCantidad" method="post">@Html.AntiForgeryToken()<input type="hidden" name="productoId" value="@item.ProductoId" /><input type="hidden" name="cantidad" value="@(item.Cantidad + 1)" /><button class="btn btn-outline-secondary">+</button></form>
                        </div>
                        <div class="text-end" style="min-width:120px"><strong>@item.Subtotal.ToString("C")</strong><form asp-action="Quitar" method="post" class="mt-2">@Html.AntiForgeryToken()<input type="hidden" name="productoId" value="@item.ProductoId" /><button class="btn btn-sm btn-outline-danger">Eliminar</button></form></div>
                    </div></div>
                }
                <a asp-controller="Home" asp-action="Index" class="btn btn-link px-0">← Continuar comprando</a>
            </div>
            <div class="col-lg-4"><div class="card"><div class="card-body">
                <h2 class="h5">Resumen del pedido</h2>
                <div class="d-flex justify-content-between"><span>Subtotal</span><span>@Model.Subtotal.ToString("C")</span></div>
                <div class="d-flex justify-content-between"><span>Envío terrestre</span><span>@Model.Envio.ToString("C")</span></div>
                <div class="d-flex justify-content-between"><span>Impuestos estimados</span><span>@Model.Impuestos.ToString("C")</span></div>
                <hr /><div class="d-flex justify-content-between fw-bold fs-5"><span>Total</span><span>@Model.Total.ToString("C")</span></div>
                <a asp-action="ConfirmarCompra" class="btn btn-primary w-100 mt-3">Finalizar compra</a>
            </div></div></div>
        </div>
    }
</div>
