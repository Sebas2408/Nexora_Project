@page
@model Nexora.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Registrarse";
}

<h1>Registrarse</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            @Html.AntiForgeryToken()
            <partial name="_ValidationScriptsPartial" />
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.Nombre" class="form-label">Nombre</label>
                <input asp-for="Input.Nombre" class="form-control" />
                <span asp-validation-for="Input.Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Apellido" class="form-label">Apellido</label>
                <input asp-for="Input.Apellido" class="form-control" />
                <span asp-validation-for="Input.Apellido" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Genero" class="form-label">Género</label>
                <select asp-for="Input.Genero" class="form-select">
                    <option value="">-- Seleccione --</option>
                    <option>Masculino</option>
                    <option>Femenino</option>
                    <option>Otro</option>
                </select>
                <span asp-validation-for="Input.Genero" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.FechaNacimiento" class="form-label">Fecha de nacimiento</label>
                <input asp-for="Input.FechaNacimiento" class="form-control" type="date" />
                <span asp-validation-for="Input.FechaNacimiento" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Contraseña</label>
                <input asp-for="Input.Password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar contraseña</label>
                <input asp-for="Input.ConfirmPassword" class="form-control" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <input type="hidden" asp-for="ReturnUrl" />
            <button type="submit" class="btn btn-primary">Registrarse</button>
        </form>
    </div>
</div>
